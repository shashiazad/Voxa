# --- LiveKit (self-hosted via compose) ---
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
# Must be >= 32 chars
LIVEKIT_API_SECRET=voxa-dev-secret-change-me-0123456789abcdef
# --- coturn ---
TURN_USER=voxa
TURN_PASSWORD=voxa-turn-dev
TURN_REALM=voxa.local
# --- API ---
API_PORT=8000
ROOM_TOKEN_TTL_SECONDS=600
# --- Providers (filled in later phases) ---
GROQ_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
# --- Phase 5: database, cache, tenants ---
DATABASE_URL=postgresql://voxa_app:voxa_app@postgres:5432/voxa
DATABASE_ADMIN_URL=postgresql://voxa:voxa@postgres:5432/voxa
REDIS_URL=redis://redis:6379/0
ADMIN_TOKEN=dev-admin-token
# Fernet key used to encrypt tenant secrets at rest (replace with a KMS-managed key in production)
VOXA_KMS_KEY=n6YpKjbcQRwqKM8WT5jYlqvQ9fEtIqBSA0wKeY-H-ME=
ACME_API_KEY=acme_dev_key_change_me
ACME_API_TOKEN=acme-dev-token
# groq | mock | rulebased   (default: groq if GROQ_API_KEY is set, else rulebased dev stand-in)
LLM_PROVIDER=
# --- Phase 6: dashboard / widget ---
JWT_SECRET=dev-jwt-secret-change-me-0123456789abcdef0123456789
SIGNUP_ENABLED=1
# dev only: allow tools to call private addresses (the sample tenant calls the acme-mock container)
TOOL_ALLOW_PRIVATE=1
ACME_ADMIN_PASSWORD=acme-admin-pass-123
LIVEKIT_PUBLIC_URL=ws://localhost:7880
# --- Phase 7: recordings (S3-compatible storage; compose runs SeaweedFS), retention, tracing ---
S3_ENDPOINT=http://s3:8333
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_BUCKET=voxa-recordings
S3_ACCESS_KEY=voxa
S3_SECRET_KEY=voxa-secret-key
RETENTION_INTERVAL_S=3600
GRAFANA_ADMIN_PASSWORD=admin
